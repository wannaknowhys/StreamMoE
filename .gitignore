# Build artifacts (versioned under build\<tag>\)
build/
out/

# Compiled binaries / objects
*.exe
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.dll

# VS Code / IDE
.vscode/
.vs/
.idea/

# OS files
Thumbs.db
Desktop.ini

# Test & Log
*.log
scratch/
*.bin
memwatch_*.log

# Runtime data
temp/

# Private local env / scripts (real machine paths, prebuilt binaries - never commit)
private/

# baseline regression artifacts (large binaries - local only, like model disk)
baseline_regression/baseline/*.bin
baseline_regression/baseline/*.json
baseline_regression/tools/*.exe
baseline_regression/temp/

# Per-node dump baseline dirs (large per-node L0 dumps + tokens - local only)
baseline_regression/baseline/gemma_129_l0/

# DeepSeek prefill prefill-export baseline dirs (upstream CPU reference + moe bucket engine - local only)
baseline_regression/baseline/deepseek_hi_up/
baseline_regression/baseline/deepseek_hi_moe/
