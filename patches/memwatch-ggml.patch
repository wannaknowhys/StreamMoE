diff --git a/ggml/src/ggml-memwatch.h b/ggml/src/ggml-memwatch.h
new file mode 100644
index 000000000..503afe350
--- /dev/null
+++ b/ggml/src/ggml-memwatch.h
@@ -0,0 +1,111 @@
+// ggml-memwatch.h - memory watchdog + allocator instrumentation for StreamMoE
+// diagnostic branch (debug/memguard). Header-only so no build system changes.
+//
+// Logs every instrumentation point to memwatch_<pid>.log in the working dir and
+// hard-exits the process once the process working set exceeds the limit.
+// Purpose: tell apart (a) real private allocations / copies vs (b) file-backed
+// page-cache residency of the mmap'd model.
+
+#ifndef GGML_MEMWATCH_H
+#define GGML_MEMWATCH_H
+
+#include <stdint.h>
+#include <string.h>
+
+#ifndef GGML_MEMWATCH_ENABLED
+#define GGML_MEMWATCH_ENABLED 1
+#endif
+
+#define GGML_MEMWATCH_LIMIT_BYTES (90ULL * 1024ULL * 1024ULL * 1024ULL)
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(_WIN32) && GGML_MEMWATCH_ENABLED
+#include <windows.h>
+#include <psapi.h>
+
+static void ggml_memwatch_log(const char * caller, const char * tag, uint64_t size, const void * ptr) {
+    static volatile LONG g_init = 0;
+    static HANDLE g_file = INVALID_HANDLE_VALUE;
+    static volatile LONG g_writes_since_flush = 0;
+    static volatile LONGLONG g_last_flush_ms = 0;
+    if (InterlockedCompareExchange(&g_init, 1, 0) == 0) {
+        // write into the OS temp dir, never into the workspace (avoid HDD flushes)
+        char tmp[MAX_PATH];
+        if (GetTempPathA(sizeof(tmp), tmp) == 0) {
+            tmp[0] = '.';
+            tmp[1] = 0;
+        }
+        char path[MAX_PATH];
+        _snprintf(path, sizeof(path), "%smemwatch_%lu.log", tmp, (unsigned long) GetCurrentProcessId());
+        g_file = CreateFileA(path, GENERIC_WRITE,
+                             FILE_SHARE_READ | FILE_SHARE_WRITE,
+                             NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (g_file != INVALID_HANDLE_VALUE) {
+            SetFilePointer(g_file, 0, NULL, FILE_END);
+        }
+    }
+
+    PROCESS_MEMORY_COUNTERS_EX pmc;
+    memset(&pmc, 0, sizeof(pmc));
+    pmc.cb = sizeof(pmc);
+    GetProcessMemoryInfo(GetCurrentProcess(), (PROCESS_MEMORY_COUNTERS *) &pmc, sizeof(pmc));
+
+    MEMORYSTATUSEX ms;
+    memset(&ms, 0, sizeof(ms));
+    ms.dwLength = sizeof(ms);
+    GlobalMemoryStatusEx(&ms);
+
+    // WS includes file-backed (mapped model) pages + private; PRIV is private only.
+    // WS - PRIV approximates file-backed resident footprint.
+    char line[512];
+    int n = _snprintf(line, sizeof(line),
+        "%s|%s|size=%llu|ptr=%p|WS=%llu|PRIV=%llu|COMMIT=%llu|FILEBK=%lld|SYS_AVAIL=%llu|SYS_TOTAL=%llu\n",
+        caller, tag,
+        (unsigned long long) size, ptr,
+        (unsigned long long) pmc.WorkingSetSize,
+        (unsigned long long) pmc.PrivateUsage,
+        (unsigned long long) pmc.PagefileUsage,
+        (long long) ((pmc.WorkingSetSize > pmc.PrivateUsage) ? (pmc.WorkingSetSize - pmc.PrivateUsage) : 0),
+        (unsigned long long) ms.ullAvailPhys,
+        (unsigned long long) ms.ullTotalPhys);
+    if (g_file != INVALID_HANDLE_VALUE && n > 0) {
+        DWORD wr = 0;
+        WriteFile(g_file, line, (DWORD) n, &wr, NULL);
+        // throttle flush: every 256 writes or >= 500ms - keeps disk quiet while the
+        // log stays fresh enough for live inspection
+        LONG count = InterlockedIncrement(&g_writes_since_flush);
+        LONGLONG now = GetTickCount64();
+        LONGLONG last = g_last_flush_ms;
+        if (count >= 256 || now - last >= 500) {
+            FlushFileBuffers(g_file);
+            InterlockedExchange(&g_writes_since_flush, 0);
+            InterlockedExchange64(&g_last_flush_ms, now);
+        }
+    }
+
+    if (pmc.WorkingSetSize > GGML_MEMWATCH_LIMIT_BYTES) {
+        if (g_file != INVALID_HANDLE_VALUE) {
+            const char * msg = "MEMWATCH LIMIT HIT: WS > 90GB, exiting\n";
+            DWORD wr = 0;
+            WriteFile(g_file, msg, (DWORD) strlen(msg), &wr, NULL);
+            FlushFileBuffers(g_file);
+            CloseHandle(g_file);
+            g_file = INVALID_HANDLE_VALUE;
+        }
+        ExitProcess(1);
+    }
+}
+#else
+static void ggml_memwatch_log(const char * caller, const char * tag, uint64_t size, const void * ptr) {
+    (void) caller; (void) tag; (void) size; (void) ptr;
+}
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // GGML_MEMWATCH_H