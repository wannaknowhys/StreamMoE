diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4caff55d1..9d7eccf69 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2,6 +2,25 @@ cmake_minimum_required(VERSION 3.14...3.28) # for add_link_options and implicit
 project("llama.cpp" C CXX)
 include(CheckIncludeFileCXX)
 
+# StreamMoE features. The dispatcher sets -DSTREAM_MOE_FEATURES=route_b[,prefill_export]
+# (feature macros are NOT passed via CMAKE_CXX_FLAGS). Applied to the whole build so
+# any file/target that later grows #ifdef STREAM_MOE_* code is never silently skipped.
+# Feature frags live in the parent repo (patches/<phase>/...) and are reachable through
+# the global include dirs below; anchor #include lines in shared files stay short-named.
+if(STREAM_MOE_FEATURES)
+    if(STREAM_MOE_FEATURES MATCHES "route_b")
+        add_compile_definitions(STREAM_MOE_ROUTE_B)
+    endif()
+    if(STREAM_MOE_FEATURES MATCHES "prefill_export")
+        add_compile_definitions(STREAM_MOE_PREFILL_EXPORT)
+    endif()
+    include_directories(
+        ${CMAKE_CURRENT_SOURCE_DIR}/../../patches/route-b/common
+        ${CMAKE_CURRENT_SOURCE_DIR}/../../patches/prefill-export/common
+        ${CMAKE_CURRENT_SOURCE_DIR}/../../patches/prefill-export/include)
+endif()
+
+
 ### llama.cpp version
 set(LLAMA_VERSION_MAJOR 0)
 set(LLAMA_VERSION_MINOR 2)
