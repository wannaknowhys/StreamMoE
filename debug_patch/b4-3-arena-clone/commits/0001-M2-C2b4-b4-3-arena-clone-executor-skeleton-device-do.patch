-// ========================= whole-layer burst executor ======================
+// ===================== arena-clone whole-layer device executor ==============
+// (docs/M2_DEVICE_EXECUTOR.md 4.1, b4-3) The whole privatised layer closure
+// (mm + weightless + anonymous convergence + moe_out) executes on ONE device
+// backend as a single vulkan cgraph over CLONE tensors that live in the device
+// arena. Main-graph tensors are never mutated (b4-2 crash: llama's scheduler
+// keeps bookkeeping the mutated buffers after the burst) - every node output is
+// a fresh ggml tensor bound to its plan.out_off arena region, every input is
+// either an arena slice of a producer clone or a staged host copy. Only
+// moe_out's result is copied back to the main dst (host) pointer.
+//
+// Memory: the whole layer's arena (sum of plan out_bytes) + stage (external
+// host inputs, deduped) are reserved ONCE before any clone is created - growing
+// the arena mid-layer frees already-bound regions.
+
+// Align a byte offset up to `align` (must be power of two).
+static size_t align_up(size_t v, size_t align) {
+    return (v + align - 1) & ~(align - 1);
+}
+
+// A fresh arena/stage leaf tensor with the shape of `tpl` bound to buffer `buf`
+// at byte offset `off`. op stays NONE (pure data leaf); vulkan kernels read
+// data/nb as given.
+static ggml_tensor* arena_leaf(ggml_context * ctx, const ggml_tensor * tpl,
+                               ggml_backend_buffer_t buf, size_t off) {
+    ggml_tensor * leaf = ggml_new_tensor(ctx, tpl->type, ggml_n_dims(tpl), tpl->ne);
+    std::memcpy(leaf->nb, tpl->nb, sizeof(leaf->nb));
+    leaf->buffer = buf;
+    leaf->data   = static_cast<char*>(stmoe_vk_buffer_host_offset(buf, off));
+    return leaf;
+}
+
+// A fresh op node clone (leaf-shaped metadata from `tpl`, op/op_params copied)
+// bound to the arena region at `off`. srcs are filled by the caller.
+static ggml_tensor* clone_op(ggml_context * ctx, const ggml_tensor * tpl,
+                             ggml_backend_buffer_t buf, size_t off) {
+    ggml_tensor * c = arena_leaf(ctx, tpl, buf, off);
+    c->op = tpl->op;
+    std::memcpy(c->op_params, tpl->op_params, sizeof(c->op_params));
+    return c;
+}
+
+// Whole-layer device (arena-clone) executor. `plan` is the layer's node plan
+// (route_b_chain), aligned with ex->compute; pins are the layer's full active
+// set on one device pool.
+static bool exec_arena_clone(int32_t layer, ggml_context * ctx, expert_scheduler & sched,
+                             const moe_model_topology_t & topo,
+                             const std::vector<moe_node_plan> & plan,
+                             uint32_t pool, const std::vector<expert_handle_t> & pins) {
+    if (plan.empty()) return true;
+    device_exec_ctx_t * dv = stream_moe_backend_device_exec(pool);
+    if (!dv || !dv->be) {
+        LOG_ERROR("stream_moe: arena-clone device exec ctx unavailable (pool " << pool << ")");
+        return false;
+    }
+
+    // ---- whole-layer budgets ----------------------------------------------
+    size_t arena_need = 0;
+    for (const auto & p : plan) arena_need = std::max(arena_need, p.out_off + p.out_bytes);
+    arena_need = align_up(arena_need, 4096);
+    // stage: external host inputs, deduped by (src pointer + consumed bytes).
+    // mm ids/cur count as external too (ids translated per mm).
+    auto stage_bytes_of = [](const ggml_tensor * t) -> size_t { return ggml_nbytes(t); };
+    size_t stage_need = 0;
+    {
+        // weightless externals
+        for (const auto & p : plan) {
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (!p.in[s].src) continue;
+                if (p.in[s].kind == moe_in_kind::k_chain) continue;
+                stage_need += align_up(stage_bytes_of(p.in[s].src), 4096);
+            }
+        }
+        // mm cur/ids (ids per mm translated size; cur host copy)
+        for (const auto & p : plan) {
+            if (p.node->op != GGML_OP_MUL_MAT_ID) continue;
+            const ggml_tensor * cur = p.node->src[1];
+            const ggml_tensor * ids = p.node->src[2];
+            // cur is external only when the gate mm reads the norm output;
+            // the down mm reads the geglu arena clone (k_chain, in[1]).
+            const auto & ri = p.in[1];
+            if (ri.kind == moe_in_kind::k_external && ri.src == cur) {
+                stage_need += align_up(stage_bytes_of(cur), 4096);
+            }
+            if (ids) stage_need += align_up(static_cast<size_t>(ids->ne[0]) * ids->ne[1] * sizeof(int32_t), 4096);
+        }
+        stage_need += 4096;
+    }
+    if (!stream_moe_backend_device_ensure(pool, arena_need + 4096, stage_need)) {
+        LOG_ERROR("stream_moe: arena-clone layer reserve failed (pool " << pool << ")");
+        return false;
+    }
+    dv = stream_moe_backend_device_exec(pool);
+    if (!dv->arena_map || !dv->stage_map) {
+        LOG_ERROR("stream_moe: arena-clone host maps unavailable (pool " << pool << ")");
+        return false;
+    }
+
+    // ---- build clones (plan order) ----------------------------------------
+    std::vector<ggml_tensor*> clone(plan.size(), nullptr);
+    std::vector<ggml_tensor*> gf_nodes;
+    gf_nodes.reserve(plan.size());
+    // staged external leaves, deduped by src pointer
+    std::unordered_map<const ggml_tensor*, ggml_tensor*> stage_leaf;
+    size_t stage_off = 0;
+    const int32_t g_n_slots = [&]() -> int32_t {
+        if (pins.empty()) return 0;
+        const auto * sp = sched.subpool_of_slot(pins[0].slot);
+        return sp ? (int32_t) sp->n_slots : 0;
+    }();
+
+    auto stage_put = [&](const ggml_tensor * src) -> ggml_tensor* {
+        auto it = stage_leaf.find(src);
+        if (it != stage_leaf.end()) return it->second;
+        if (!src->data) return nullptr;
+        const size_t need = ggml_nbytes(src);
+        stage_off = align_up(stage_off, 4096);
+        if (stage_off + need > dv->stage_cap) { LOG_ERROR("stream_moe: stage overflow"); return nullptr; }
+        std::memcpy(dv->stage_map + stage_off, src->data, need);
+        ggml_tensor * leaf = arena_leaf(ctx, src, dv->stage, stage_off);
+        stage_off += need;
+        stage_leaf[src] = leaf;
+        return leaf;
+    };
+
+    for (size_t ci = 0; ci < plan.size(); ++ci) {
+        const moe_node_plan & p = plan[ci];
+        ggml_tensor * nd = p.node;
+        if (nd->op == GGML_OP_MUL_MAT_ID) {
+            // ---- mm clone: weight shell + cur (arena or staged) + ids -----
+            parsed_node_t pn = parse_weight_name(nd->src[0]->name);
+            if (!pn.ok) { LOG_ERROR("stream_moe: arena-clone bad weight name"); return false; }
+            size_t boff = 0, bbytes = 0;
+            if (!sched.branch_layout(pn.layer, 0, nd->src[0]->name, boff, bbytes)) return false;
+            const auto * osp = pins.empty() ? nullptr : sched.subpool_of_slot(pins[0].slot);
+            if (!osp || osp->pool != pool) { LOG_ERROR("stream_moe: arena-clone no device subpool"); return false; }
+            const expert_scheduler::subpool_t & sp = *osp;
+
+            const ggml_tensor * cur = nd->src[1];
+            const ggml_tensor * ids = nd->src[2];
+            ggml_tensor * ids_leaf = nullptr;
+            if (ids && ids->data) {
+                const size_t n_ids = (size_t) ids->ne[0] * ids->ne[1];
+                stage_off = align_up(stage_off, 4096);
+                if (stage_off + n_ids * 4 > dv->stage_cap) return false;
+                auto * slot32 = reinterpret_cast<int32_t*>(dv->stage_map + stage_off);
+                const auto & ri = p.in[2];
+                (void) ri;
+                for (size_t i = 0; i < n_ids; ++i) {
+                    // ids hold EXPERT indices -> translate to region-local slot
+                    const int32_t e = MOE_ID_AT(ids, (int)(i / ids->ne[0]), (int)(i % ids->ne[0]));
+                    int32_t slot = -1;
+                    for (const auto & h : pins) {
+                        if (h.pinned && h.layer == pn.layer && h.expert == (uint32_t) e) { slot = h.slot; break; }
+                    }
+                    int32_t local = -1;
+                    if (slot >= 0) {
+                        const auto * ssp = sched.subpool_of_slot(slot);
+                        if (ssp && ssp == &sp) local = slot - (int32_t) sp.slot_begin;
+                    }
+                    if (local < 0) {
+                        LOG_ERROR("stream_moe: arena-clone mm expert not in region slot");
+                        return false;
+                    }
+                    slot32[i] = local;
+                }
+                ids_leaf = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, ids->ne[0], ids->ne[1]);
+                ids_leaf->buffer = dv->stage;
+                ids_leaf->data   = static_cast<char*>(stmoe_vk_buffer_host_offset(dv->stage, stage_off));
+                stage_off += n_ids * 4;
+            }
+
+            ggml_tensor * cur_leaf = nullptr;
+            const auto & cri = p.in[1];
+            if (cri.kind == moe_in_kind::k_chain) {
+                // producer arena clone (e.g. geglu feeding the down mm)
+                const ggml_tensor * prod = plan[cri.prod].node;
+                ggml_tensor * base = clone[cri.prod];
+                if (!base) return false;
+                cur_leaf = arena_leaf(ctx, prod, dv->arena,
+                                      plan[cri.prod].out_off + (size_t) cri.off);
+            } else {
+                cur_leaf = stage_put(cur);
+                if (!cur_leaf) return false;
+            }
+
+            ggml_backend_buffer_t wbuf = reinterpret_cast<ggml_backend_buffer_t>(sp.dev_buf);
+            ggml_tensor * w3d = ggml_new_tensor_3d(ctx, nd->src[0]->type, nd->src[0]->ne[0], nd->src[0]->ne[1], 1);
+            w3d->ne[2] = g_n_slots;
+            w3d->nb[2] = sp.expert_size;
+            w3d->nb[3] = sp.expert_size * (size_t) g_n_slots;
+            w3d->buffer = wbuf;
+            w3d->data   = static_cast<char*>(stmoe_vk_buffer_host_offset(wbuf, boff));
+
+            ggml_tensor * mm = ggml_mul_mat_id(ctx, w3d, cur_leaf, ids_leaf);
+            mm->buffer = dv->arena;
+            mm->data   = static_cast<char*>(stmoe_vk_buffer_host_offset(dv->arena, p.out_off));
+            clone[ci] = mm;
+            gf_nodes.push_back(mm);
+            continue;
+        }
+
+        // ---- weightless compute clone --------------------------------------
+        // copy shape/op from the main node, srcs resolved to clones/stage
+        ggml_tensor * c = clone_op(ctx, nd, dv->arena, p.out_off);
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (!nd->src[s]) continue;
+            const moe_resolved_in & ri = p.in[s];
+            ggml_tensor * in_t = nullptr;
+            if (ri.kind == moe_in_kind::k_chain) {
+                ggml_tensor * base = clone[ri.prod];
+                if (!base) { LOG_ERROR("stream_moe: arena-clone missing producer " << ci << " src" << s); return false; }
+                if ((size_t) ri.off == 0 && ri.src == plan[ri.prod].node) {
+                    in_t = base;                       // whole producer output
+                } else {
+                    in_t = arena_leaf(ctx, ri.src, dv->arena,
+                                      plan[ri.prod].out_off + (size_t) ri.off);
+                }
+            } else {
+                in_t = stage_put(ri.src);
+                if (!in_t) return false;
+            }
+            c->src[s] = in_t;
+        }
+        clone[ci] = c;
+        gf_nodes.push_back(c);
+    }
+
+    // ---- one vulkan graph_compute over the whole layer closure -------------
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    if ((size_t) gf->size < gf_nodes.size()) {
+        LOG_ERROR("stream_moe: arena-clone graph overflow");
+        return false;
+    }
+    for (size_t i = 0; i < gf_nodes.size(); ++i) gf->nodes[i] = gf_nodes[i];
+    gf->n_nodes = (int) gf_nodes.size();
+
+    if (ggml_backend_graph_compute(dv->be, gf) != GGML_STATUS_SUCCESS) {
+        LOG_ERROR("stream_moe: arena-clone layer compute failed (layer " << layer << ")");
+        return false;
+    }
+
+    // ---- moe_out readback to the main dst (host pointer) -------------------
+    for (size_t ci = 0; ci < plan.size(); ++ci) {
+        if (!plan[ci].is_out) continue;
+        ggml_tensor * nd = plan[ci].node;
+        if (clone[ci] && nd->data) {
+            std::memcpy(nd->data, dv->arena_map + plan[ci].out_off, plan[ci].out_bytes);
+        }
+    }
+    return true;
+}
+
+
 // M2 executor (docs/M2_DEVICE_EXECUTOR.md 2.2): llama delivers the privatised
 // chain one node per graph_compute; on the layer's first node we run the WHOLE
 // captured sequence at once. Hidden outputs go to a per-layer full-alloc buffer
@@ -634,158 +887,6 @@ static bool exec_one_burst(ggml_context * ctx, ggml_backend_t cpu, expert_schedu
