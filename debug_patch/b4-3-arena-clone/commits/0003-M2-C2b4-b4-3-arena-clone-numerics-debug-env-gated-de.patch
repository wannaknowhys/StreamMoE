+// Per-node output dump for the CPU-vs-GPU whole-layer comparison (env
+// STREAM_MOE_DUMP_DIR + STREAM_MOE_DUMP_LAYER gate). Writes one binary file per
+// (layer, compute-index) holding the node's output bytes exactly as the CPU /
+// arena-clone path produced them, plus a sidecar line for mapping. Single
+// debug feature - zero cost when the env is unset.
+static void layer_dump_out(const char * side, int32_t layer, int ci,
+                           const char * op, const char * name,
+                           const void * data, size_t nbytes) {
+    const char * dir = getenv("STREAM_MOE_DUMP_DIR");
+    if (!dir) return;
+    const char * lstr = getenv("STREAM_MOE_DUMP_LAYER");
+    if (!lstr || atoi(lstr) != (int) layer) return;
+    char path[512];
+    snprintf(path, sizeof(path), "%s/%s_L%02d_c%02d.bin", dir, side, layer, ci);
+    FILE * f = fopen(path, "wb");
+    if (!f) return;
+    fwrite(data, 1, nbytes, f);
+    fclose(f);
+    fprintf(stderr, "[layerdump] %s L%d c%d op=%s name=%s bytes=%zu\n",
+            side, layer, ci, op ? op : "?", name ? name : "?", nbytes);
+    fflush(stderr);
+}
+
 // Whole-layer device (arena-clone) executor. `plan` is the layer's node plan
 // (route_b_chain), aligned with ex->compute; pins are the layer's full active
 // set on one device pool.
@@ -437,8 +460,29 @@ static bool exec_arena_clone(int32_t layer, ggml_context * /*ctx*/, expert_sched
     };
 
     // ---- whole-layer budgets ----------------------------------------------
+    size_t arena_plan_end = 0;
+    for (const auto & p : plan) arena_plan_end = std::max(arena_plan_end, p.out_off + p.out_bytes);
     size_t arena_need = 0;
-    for (const auto & p : plan) arena_need = std::max(arena_need, p.out_off + p.out_bytes);
+    // Strided k_chain view inputs (weighted per-expert slices feeding the
+    // anonymous adds) get a CONT copy to a contiguous arena region: vulkan
+    // elementwise kernels index linearly, a strided leaf would read garbage.
+    // Budget one contiguous copy per non-contiguous chain-view src.
+    {
+        size_t cont_need = 0;
+        for (const auto & p : plan) {
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                const ggml_tensor * src = p.node->src[s];
+                if (!src) continue;
+                if (p.in[s].kind != moe_in_kind::k_chain) continue;
+                if (p.in[s].prod < 0 || p.in[s].prod >= (int) plan.size()) continue;
+                if (src == plan[p.in[s].prod].node) continue;   // direct edge: reuse clone
+                if (ggml_is_contiguous(src)) continue;
+                cont_need += align_up(ggml_nelements(src) * ggml_element_size(src), 4096);
+            }
+        }
+        arena_plan_end = align_up(arena_plan_end, 4096);
+        arena_need = arena_plan_end + cont_need + 4096;
+    }
     arena_need = align_up(arena_need, 4096);
     // stage: external host inputs, deduped by (src pointer + consumed bytes).
     // mm ids/cur count as external too (ids translated per mm).
@@ -485,6 +529,10 @@ static bool exec_arena_clone(int32_t layer, ggml_context * /*ctx*/, expert_sched
     // staged external leaves, deduped by src pointer
     std::unordered_map<const ggml_tensor*, ggml_tensor*> stage_leaf;
     size_t stage_off = 0;
+    // contiguous-copy arena region (appended after the plan regions): strided
+    // chain-view slices are cont'd here so vulkan elementwise ops read them
+    // linearly.
+    size_t cont_off = align_up(arena_plan_end, 4096);
     const int32_t g_n_slots = [&]() -> int32_t {
         if (pins.empty()) return 0;
         const auto * sp = sched.subpool_of_slot(pins[0].slot);
@@ -581,8 +629,28 @@ static bool exec_arena_clone(int32_t layer, ggml_context * /*ctx*/, expert_sched
                 cur_leaf = arena_leaf(actx, prod, dv->arena,
                                       plan[cri.prod].out_off + (size_t) cri.off);
             } else {
-                cur_leaf = stage_put(cur);
-                if (!cur_leaf) return false;
+                // External cur (norm output). Uploaded contiguously into the
+                // stage; the mm activation leaf must carry a CONTIGUOUS nb - the
+                // src may be a reshaped tensor whose nb is the base stride
+                // (exec_mm_vk deliberately ignores cur->nb for external cur).
+                const size_t cur_bytes = ggml_nbytes(cur);
+                stage_off = align_up(stage_off, 4096);
+                if (stage_off + cur_bytes > dv->stage_cap) {
+                    LOG_ERROR("stream_moe: arena-clone stage overflow (mm cur)");
+                    return actx_guard(false);
+                }
+                std::memcpy(dv->stage_map + stage_off, cur->data, cur_bytes);
+                if (getenv("STREAM_MOE_ACDBG")) {
+                    fprintf(stderr, "[ac] mmcur ci=%zu %s ne=%lldx%lld nb=%zu,%zu bytes=%zu contig=%d\n",
+                            ci, cur->name ? cur->name : "?", (long long) cur->ne[0],
+                            (long long) cur->ne[1], cur->nb[0], cur->nb[1], cur_bytes,
+                            ggml_is_contiguous(cur));
+                    fflush(stderr);
+                }
+                cur_leaf = ggml_new_tensor_3d(actx, cur->type, cur->ne[0], cur->ne[1], cur->ne[2]);
+                cur_leaf->buffer = dv->stage;
+                cur_leaf->data   = static_cast<char*>(stmoe_vk_buffer_host_offset(dv->stage, stage_off));
+                stage_off += cur_bytes;
             }
 
             ggml_backend_buffer_t wbuf = reinterpret_cast<ggml_backend_buffer_t>(sp.dev_buf);
@@ -615,11 +683,45 @@ static bool exec_arena_clone(int32_t layer, ggml_context * /*ctx*/, expert_sched
             if (ri.kind == moe_in_kind::k_chain) {
                 ggml_tensor * base = clone[ri.prod];
                 if (!base) { LOG_ERROR("stream_moe: arena-clone missing producer " << ci << " src" << s); return false; }
-                if ((size_t) ri.off == 0) {
-                    in_t = base;                       // whole producer output
+                if (nd->src[s] == plan[ri.prod].node) {
+                    in_t = base;                       // whole producer output (direct edge)
                 } else {
-                    in_t = arena_leaf(actx, nd->src[s], dv->arena,
-                                      plan[ri.prod].out_off + (size_t) ri.off);
+                    // a view/reshape slice of the producer (off may be 0 but the
+                    // shape differs - e.g. the gate/up halves of a fused mm out)
+                    ggml_tensor * vleaf = arena_leaf(actx, nd->src[s], dv->arena,
+                                                     plan[ri.prod].out_off + (size_t) ri.off);
+                    if (ggml_is_contiguous(nd->src[s])) {
+                        in_t = vleaf;                  // contiguous slice: read in place
+                    } else {
+                        // strided slice (weighted per-expert views feeding the
+                        // anonymous adds): vulkan elementwise kernels index
+                        // linearly -> materialize a contiguous copy in the
+                        // cont region first (cpy pipeline handles strided src).
+                        // Hand-built DUP op: ggml_dup() may return the src when
+                        // it considers the copy redundant, which we must avoid.
+                        ggml_tensor * cc = ggml_new_tensor(actx, vleaf->type,
+                                                           ggml_n_dims(vleaf), vleaf->ne);
+                        cc->op = GGML_OP_DUP;
+                        cc->src[0] = vleaf;   // strided view leaf (contiguous dst by default nb)
+                        const size_t cneed = ggml_nbytes(cc);
+                        cont_off = align_up(cont_off, 4096);
+                        if (cont_off + cneed > dv->arena_cap) {
+                            LOG_ERROR("stream_moe: arena-clone cont region overflow");
+                            return actx_guard(false);
+                        }
+                        cc->buffer = dv->arena;
+                        cc->data   = static_cast<char*>(stmoe_vk_buffer_host_offset(dv->arena, cont_off));
+                        cont_off += cneed;
+                        gf_nodes.push_back(cc);   // registered for expand; consumed via in_t
+                        if (getenv("STREAM_MOE_ACDBG")) {
+                            fprintf(stderr, "[ac] cont ci=%zu src%d %s ne=%lldx%lld off=%zu->%zu nneed=%zu\n",
+                                    ci, s, nd->src[s]->name ? nd->src[s]->name : "?",
+                                    (long long) vleaf->ne[0], (long long) vleaf->ne[1],
+                                    (size_t) ri.off, cont_off - cneed, cneed);
+                            fflush(stderr);
+                        }
+                        in_t = cc;
+                    }
                 }
             } else {
                 in_t = stage_put(nd->src[s]);
@@ -632,13 +734,20 @@ static bool exec_arena_clone(int32_t layer, ggml_context * /*ctx*/, expert_sched
     }
 
     // ---- one vulkan graph_compute over the whole layer closure -------------
+    // Build via ggml_build_forward_expand (NOT by filling nodes[] by hand):
+    // vulkan's graph_compute relies on ggml's internal graph structure
+    // (nodes/leafs/hash/visited). Each clone op is expanded from its own dst;
+    // ggml dedups already-visited tensors, so the union covers the DAG exactly
+    // once in dependency order. Leaves (op == NONE, arena/stage/weight shells)
+    // never enter nodes[] - they are plain inputs the kernels read directly.
     ggml_cgraph * gf = ggml_new_graph(actx);
     if ((size_t) gf->size < gf_nodes.size()) {
         LOG_ERROR("stream_moe: arena-clone graph overflow");
         return actx_guard(false);
     }
-    for (size_t i = 0; i < gf_nodes.size(); ++i) gf->nodes[i] = gf_nodes[i];
-    gf->n_nodes = (int) gf_nodes.size();
+    for (ggml_tensor * nd : gf_nodes) {
+        ggml_build_forward_expand(gf, nd);
+    }
 
     if (ggml_backend_graph_compute(dv->be, gf) != GGML_STATUS_SUCCESS) {
         LOG_ERROR("stream_moe: arena-clone layer compute failed (layer " << layer << ")");
@@ -653,6 +762,14 @@ static bool exec_arena_clone(int32_t layer, ggml_context * /*ctx*/, expert_sched
             std::memcpy(nd->data, dv->arena_map + plan[ci].out_off, plan[ci].out_bytes);
         }
     }
+    // ---- per-node output dump (CPU-vs-GPU comparison) ----------------------
+    if (getenv("STREAM_MOE_DUMP_DIR") && getenv("STREAM_MOE_DUMP_LAYER")) {
+        for (size_t ci = 0; ci < plan.size(); ++ci) {
+            const ggml_tensor * nd = plan[ci].node;
+            layer_dump_out("gpu", layer, (int) ci, ggml_op_name(nd->op),
+                           nd->name, dv->arena_map + plan[ci].out_off, plan[ci].out_bytes);
+        }
+    }
     return actx_guard(true);
 }
 
@@ -1012,9 +1129,16 @@ static enum ggml_status exec_layer_burst(int32_t layer, ggml_context * ctx,
     } else {
         moe_chain_set_full_alloc(lsum);
         reset_layer(layer);
+        int ci = 0;
         for (const auto * cn : ex->compute) {
             if (!ok) break;
-            ok = exec_one_burst(ctx, cpu, sched, topo, const_cast<ggml_tensor*>(cn), layer, pins);
+            ggml_tensor * nd = const_cast<ggml_tensor*>(cn);
+            ok = exec_one_burst(ctx, cpu, sched, topo, nd, layer, pins);
+            if (getenv("STREAM_MOE_DUMP_DIR") && getenv("STREAM_MOE_DUMP_LAYER")) {
+                layer_dump_out("cpu", layer, ci, ggml_op_name(nd->op),
