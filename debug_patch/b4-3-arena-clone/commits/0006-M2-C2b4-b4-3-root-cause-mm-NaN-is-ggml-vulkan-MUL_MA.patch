+        // ---- input dump: every clone's stage/wbuf (external) src leaves -----
+        for (size_t ci = 0; ci < plan.size(); ++ci) {
+            const ggml_tensor * c = clone[ci];
+            if (!c) continue;
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                const ggml_tensor * t = c->src[s];
+                if (!t) continue;
+                const uint8_t * base = nullptr;
+                const char * kind = "?";
+                if (t->buffer == dv->stage) { base = dv->stage_map; kind = "stage"; }
+                else if (t->buffer == wbuf) { base = static_cast<const uint8_t*>(stmoe_vk_buffer_host_ptr(wbuf)); kind = "wbuf"; }
+                else continue;                    // arena (chain): not ready yet
+                if (!base) continue;
+                const size_t off = static_cast<size_t>((const char*)t->data - fakebase);
+                // Length: non-quantized leaves are contiguous element bytes; the
+                // Q4_K weight shell gets a bounded head dump (full shell would be
+                // the whole slot pool). b_leaf type Q4_K -> ggml_nelements is not
+                // row bytes, so use a plain head cap there.
+                const bool quant = ggml_is_quantized(t->type);
+                const size_t nbytes = quant ? 8192u
+                                            : ggml_nelements(t) * ggml_element_size(t);
+                char path[512];
+                snprintf(path, sizeof path, "%s/l0in_c%02zu_s%d_%s_%s.bin", dir, ci, s, kind,
